         {%- when 'buttons' -%}
<style>
  /* 1. BUTTON ROW CONTAINER */
  .custom-button-row {
    display: flex !important;
    gap: 10px !important; /* The ONLY space between the buttons */
    width: {{ block.settings.button_width_percent }}% !important; 
    margin: 25px 0 !important; /* Margin 0 keeps it aligned to the left like your text */
    padding: 0 !important;
    box-sizing: border-box !important;
  }

  /* 2. BUTTON COLUMN WRAPPERS */
  .custom-btn-col {
    flex: 1 1 50% !important;
    display: flex !important;
  }

  /* 3. BASE BUTTON STYLES (THE RESET) */
  #fixed-add-to-bag, 
  #fixed-buy-now {
    all: unset !important; /* Kills theme bullshit */
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    height: {{ block.settings.button_height }}px !important;
    width: 100% !important;
    cursor: pointer !important;
    font-family: 'Montserrat', sans-serif !important;
    font-weight: 600 !important;
    font-size: {{ block.settings.button_font_size }}px !important;
    text-transform: uppercase !important;
    letter-spacing: 1px !important;
    box-sizing: border-box !important;
    text-align: center !important;
    transition: opacity 0.2s ease, background-color 0.2s ease !important;
  }

  /* 4. ADD TO BAG (BLACK) */
  #fixed-add-to-bag {
    background-color: #000 !important;
    color: #fff !important;
    border: 1px solid #000 !important;
  }
  #fixed-add-to-bag:hover {
    opacity: 0.8 !important;
  }

  /* 5. BUY NOW (WHITE) */
  #fixed-buy-now {
    background-color: #fff !important;
    color: #000 !important;
    border: 1px solid #000 !important;
  }
  #fixed-buy-now:hover {
    background-color: #f4f4f4 !important;
  }

  /* 6. MOBILE & TABLET RESPONSIVENESS */
  @media (max-width: 767px) {
    .custom-button-row {
      width: 100% !important; /* Full width on mobile regardless of slider */
      flex-direction: column !important;
    }
    .custom-btn-col {
      width: 100% !important;
    }
  }
  @media (min-width: 768px) and (max-width: 1024px) {
    .custom-button-row {
      width: 100% !important; /* Overrides the 69% default to give buttons room on tablet */
      gap: 6px !important;
    }
    #fixed-add-to-bag, #fixed-buy-now {
      font-size: 12px !important; /* Scales text down slightly to fit side-by-side cleanly */
      padding: 0 4px !important;
    }
  }
</style>

