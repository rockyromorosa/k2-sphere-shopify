<style>
@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@600&display=swap');
</style>
<style>
/* ========================================= */
/* 1. CUSTOM SIZE BUTTONS (RECTANGLES)       */
/* ========================================= */
/* --- HIDE SECTION ON MOBILE START --- */
@media only screen and (max-width: 767px) {
  #ProductSection-{{ section.id }} {
    display: none !important;
  }
}
/* Force the black border to stay hidden during the switch */
.product-single__thumbnails.is-switching .slick-current,
.product-single__thumbnails.is-switching .slick-active {
    outline: none !important;
    border-color: transparent !important;
    box-shadow: none !important;
}
/* ========================================= */
/* REMOVE THUMBNAIL BLACK BORDER (FORCE)     */
/* ========================================= */

/* 1. Remove border from the wrapper div */
.product-single__thumbnails .slick-slide.is-active,
.product-single__thumbnails .slick-slide.slick-current,
.product-single__thumbnails .slick-slide.slick-active {
    border: none !important;
    box-shadow: none !important;
    outline: none !important;
}

/* 2. Remove border from the inner LINK <a> tag (Most likely culprit) */
.product-single__thumbnails .slick-slide.is-active .product-single__thumbnail,
.product-single__thumbnails .slick-slide.slick-current .product-single__thumbnail,
.product-single__thumbnails .slick-slide.slick-active .product-single__thumbnail {
    border: none !important;
    box-shadow: none !important;
    outline: none !important;
}

/* 3. Remove border if it's a pseudo-element ::after */
.product-single__thumbnails .slick-slide .product-single__thumbnail::after,
.product-single__thumbnails .slick-slide.is-active .product-single__thumbnail::after,
.product-single__thumbnails .slick-slide.slick-current .product-single__thumbnail::after {
    content: none !important;
    display: none !important;
    border: none !important;
}
/* Optional: If your theme uses an 'after' element for the border */
.product-single__thumbnails.is-switching .slick-slide::after {
    display: none !important;
}
/* ========================================= */
/* TABLET GALLERY FIX (SAFE STICKY)          */
/* ========================================= */
@media (min-width: 768px) and (max-width: 1024px) {
  /* 1. Hide the thumbnails completely on tablet */
  #ProductSection-{{ section.id }} .product-single__thumbnails {
    display: none !important;
  }
  
  /* 2. Reset the main gallery without breaking the grid */
  #ProductSection-{{ section.id }} .my-gallery {
    width: 100% !important;
    max-width: 100% !important;
    margin-left: 0 !important;
  }

  /* 3. Apply sticky strictly to the column itself */
  #ProductSection-{{ section.id }} .photos-sticky {
    position: -webkit-sticky !important;
    position: sticky !important;
    top: 20px !important;
    align-self: flex-start !important; /* This stops the column from stretching so it sticks */
    z-index: 9 !important;
  }
}
/* --- HIDE SECTION ON MOBILE END --- */
.single-option-radio label[for*="ProductSelect-option-size-"],
.single-option-radio label[for*="ProductSelect-option-Size-"] {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  min-width: 50px !important;
  height: 40px !important;
  padding: 0 10px !important;
  margin: 25 16px 16px 0 !important;
  border: 1px solid #cfcfcf !important;
  border-radius: 4px !important;
  background-color: #fff !important;
  color: #333 !important;
  font-size: 14px !important;
  font-weight: 500 !important;
  text-transform: uppercase !important;
  cursor: pointer !important;
  text-indent: 0 !important;
  width: auto !important;
  opacity: 1 !important;
}

/* ADD THIS TO CREATE THE FIRST GAP */
.selector-wrapper.product-form__item {
  margin-bottom: 16px !important; 
}

.single-option-radio label[for*="ProductSelect-option-size-"]:hover,
.single-option-radio label[for*="ProductSelect-option-Size-"]:hover {
  border-color: #000 !important;
}

.single-option-selector__radio:checked + label[for*="ProductSelect-option-size-"],
.single-option-selector__radio:checked + label[for*="ProductSelect-option-Size-"] {
  border: 1px solid #000 !important;
  background-color: #000 !important;
  color: #fff !important;
  transform: none !important;
  border-width: 1px !important;
}
/* ========================================= */
/* COMPLETELY ISOLATED BUTTON LOGIC          */
/* ========================================= */

.custom-button-row {
  display: flex !important;
  gap: 10px !important;
  width: 100% !important;
  margin: 20px 0 !important;
  padding: 0 !important;
  box-sizing: border-box !important;
}

.custom-btn-col {
  flex: 1 1 50% !important; /* Forces both to be exactly half */
}



/* Add To Bag Specifics */
#fixed-add-to-bag {
  background-color: #000 !important;
  color: #fff !important;
  border: 1px solid #000 !important;
}

/* Buy Now Specifics */
#fixed-buy-now {
  background-color: #fff !important;
  color: #000 !important;
  border: 1px solid #000 !important;
}

/* Hover States */
#fixed-add-to-bag:hover { opacity: 0.8 !important; }
#fixed-buy-now:hover { background-color: #f4f4f4 !important; }

/* Mobile Stack */
@media (max-width: 767px) {
  .custom-button-row {
    flex-direction: column !important;
  }
  .custom-btn-col {
    width: 100% !important;
  }
}
/* ========================================= */
/* 5. OTHER STYLES (Tabs, Swatches, etc)     */
/* ========================================= */
.single-option-selector__radio { display: none !important; }

/* Circle Colors */
.single-option-radio label[for*="ProductSelect-option-color-"] {
  display: inline-block !important;
  width: 32px !important;
  height: 32px !important;
  border-radius: 50% !important;
  margin: 15 16px 16px 0 !important;
  border: 2px solid #e0e0e0 !important;
  cursor: pointer !important;
  text-indent: -9999px !important;
  overflow: hidden !important;
}
label[for="ProductSelect-option-color-Black"] { background-color: #000000 !important; }
label[for="ProductSelect-option-color-White"] { background-color: #ffffff !important; border-color: #ccc !important; }
label[for="ProductSelect-option-color-Gray"] { background-color: #808080 !important; }
label[for="ProductSelect-option-color-Lavender"] { background-color: #e6e6fa !important; }
label[for="ProductSelect-option-color-Blue Sky"], label[for="ProductSelect-option-color-Blue\ Sky"] { background-color: #87ceeb !important; }
label[for="ProductSelect-option-color-Apricot"] { background-color: #fbceb1 !important; }
label[for="ProductSelect-option-color-Hot Pink"], label[for="ProductSelect-option-color-Hot\ Pink"] { background-color: #ff69b4 !important; }
label[for="ProductSelect-option-color-Beige"] { background-color: #f5f5dc !important; }

.single-option-selector__radio:checked + label {
  border-color: #333 !important;
  border-width: 3px !important;
  transform: scale(1.1) !important;
}

/* Misc Hiding */
.product-block.product-title .product-vendor, 
.js-contact-soldout, 
.modal-backdrop.show,
.shopify-payment-button__more-options {
  display: none !important;
}

/* --- GRID SWATCH STYLES --- */
.grid-swatch-list {
  display: flex;
  align-items: center;
  gap: 5px;
  margin-top: 8px;
  margin-bottom: 8px;
  flex-wrap: wrap;
}
.grid-swatch-dot {
  display: inline-block;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  border: 1px solid rgba(0,0,0,0.1); 
  cursor: pointer;
}
.grid-swatch-more {
  font-size: 11px;
  color: #666;
  margin-left: 2px;
}

/* --- CUSTOM TABS & SPACING FIX --- */
.custom-product-tabs {
  margin-top: 0px;
  margin-bottom: 0px !important; 
  border-top: none !important; /* Hides the line */
  padding-top: 0px !important; /* Removes space below the line */
  padding-bottom: 10px !important;
}

/* --- SIMILAR TO THIS (MATCHING PRODUCT TITLE) --- */
.product-block h4.mb-4 {
  margin-top: 0 !important;
  padding-top: 0 !important;
  text-align: center !important; /* CHANGED BACK TO CENTER */
  width: 100% !important;
  display: block !important;
  
  /* MATCHING H1 PRODUCT TITLE STYLES */
  font-family: 'Montserrat', sans-serif !important;
  font-weight: 600 !important;    
  text-transform: uppercase !important; 
  color: #000000 !important;      
  letter-spacing: 0.5px !important; 
  font-size: 20px !important;     
}

.tabs-header { display: flex; gap: 30px; margin-bottom: 20px; list-style: none; padding: 0; border-bottom: 1px solid transparent; flex-wrap: wrap; }
@media (min-width: 768px) and (max-width: 1024px) {
  .tabs-header { gap: 12px; }
  .tab-link { font-size: 13px !important; }
}.tab-link { font-size: 16px; font-weight: 600; color: #999; cursor: pointer; padding-bottom: 5px; position: relative; transition: color 0.3s; }
.tab-link.active { color: #000; text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 2px; }
.tab-content-item { display: none; font-size: 14px; line-height: 1.6; color: #333; }
.tab-content-item.active { display: block; animation: fadeIn 0.5s; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.fit-predictor-container { margin-top: 5px; margin-bottom: 15px; font-size: 13px; color: #555; }
.fit-predictor-link { text-decoration: underline; cursor: pointer; }
.size-guide-modal-opener { text-decoration: underline !important; text-underline-offset: 3px; }

/* --- FORCE REMOVE BOTTOM WHITE SPACE --- */
.product-single, 
.product-single__info-wrapper, 
#ProductSection-{{ section.id }} {
    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
}
.custom-product-tabs {
    padding-bottom: 0 !important;
    margin-bottom: 0 !important;
    border-bottom: none !important;
}
/* Reduce top padding of the cross-sell section if it appears immediately after */
.product-cross-sell, .cross-sell {
    margin-top: 0 !important;
    padding-top: 20px !important; /* Small buffer */
}
</style>
<div class="{{ section.settings.setwidth }} js-recently-view{% if section.settings.mobile_compact_mode %} mobile-compact{% endif %}" itemscope itemtype="http://schema.org/Product" id="ProductSection-{{ section.id }}"  data-id="{{ section.settings.media_style }}" 
  data-section-id="{{ section.id }}" 
  data-section-type="product" 
  data-enable-history-state="true" 
  data-ajax="true" 
  data-stock="{{ section.settings.stock_enable }}" 
  data-handle="{{ product.handle }}"
  data-autoplay="{{ section.settings.e_autoplay }}"
  data-videoloop="{{ section.settings.e_loop }}">
  {%- liquid
    assign current_variant = product.selected_or_first_available_variant
    assign left_size = 'col-md-6 col-12'
    assign right_size = 'col-md-6 col-12'
    case section.settings.media_size 
    when 'small' 
    assign left_size = 'col-md-5 col-12'
    assign right_size = 'col-md-7 col-12'
    when 'normal' 
    assign left_size = 'col-md-6 col-12'
    assign right_size = 'col-md-6 col-12'
    when 'large' 
    assign left_size = 'col-md-7 col-12'
    assign right_size = 'col-md-5 col-12'
    endcase
    assign featured_img = current_variant.featured_image | default: product.featured_image 

    assign media_style = section.settings.media_style
  -%}
  <meta itemprop="name" content="{{ product.title }}">
  <meta itemprop="url" content="{{ shop.url }}{{ product.url }}">
  <meta itemprop="image" content="{{ product.featured_image.src | image_url: width: 600, height: 600 }}">
  <meta itemprop="brand" content="{{ product.vendor }}">

  <div class="row product-single">
    <div class="{{ left_size }} 
      {% unless media_style == 'media-list' or media_style == 'media-grid' or media_style == 'media-collage-1' or media_style == 'media-collage-2' %} 
      photos-sticky 
    {% endunless %}">
    {% render 'product-media', product : product, featured_image: featured_img, image_size: section.settings.image_size, loop: section.settings.enable_video_looping, media_style: section.settings.media_style %}
    </div>
    <div class="{{ right_size }} order-1 
      {% if  media_style == 'media-list' or media_style == 'media-grid' or media_style == 'media-collage-1' or media_style == 'media-collage-2' %} 
      photos-sticky 
      {% endif %}" itemprop="offers" itemscope itemtype="http://schema.org/Offer">
      <div class="product-single__info-wrapper">
        <meta itemprop="priceCurrency" content="{{ shop.currency }}">
        <link itemprop="availability" href="http://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}">
        <div class="product-single__meta small--text-center">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
           {%- when 'text' -%}
  <p
    class="product-block product__text{% if block.settings.text_style == 'uppercase' %} text-uppercase {% elsif block.settings.text_style == 'subtitle' %} subtop{% endif %}"
    style="font-size: {{ block.settings.text_font_size }}px;"
    {{ block.shopify_attributes }}
  >
    {{- block.settings.text -}}
  </p>
{%- when 'title' -%}
<style>
    /* This CSS is scoped to this block and will override the theme */
    #ProductSection-{{ section.id }} .final-wishlist-fix .js-btn-wishlist {
        font-size: 0 !important; /* This force-hides the "Go to wishlist" text */
        line-height: 0;
        display: inline-block;
    }
    #ProductSection-{{ section.id }} .final-wishlist-fix .js-btn-wishlist svg {
        display: inline-block;
        width: 24px !important;  /* Gives the icon breathing room */
        height: 24px !important; /* Gives the icon breathing room */
    }
    #ProductSection-{{ section.id }} .final-wishlist-fix .js-btn-wishlist svg path {
        fill: transparent !important;
        stroke: #000 !important;      /* BOLD BLACK BORDER */
        stroke-opacity: 1 !important;    /* 100% VISIBLE */
        stroke-width: 2.5px !important;  /* THICK AND NOT CLIPPED */
        vector-effect: non-scaling-stroke;
    }
  /* 1. HOVER State: Fills black when mouse is over it */
    #ProductSection-{{ section.id }} .final-wishlist-fix .js-btn-wishlist:hover svg path {
        fill: #000000 !important;
        stroke: #000000 !important;
    }

    /* 2. CLICKED/ACTIVE State: Fills black when added to wishlist */
    #ProductSection-{{ section.id }} .final-wishlist-fix .js-btn-wishlist.is-active svg path,
    #ProductSection-{{ section.id }} .final-wishlist-fix .js-btn-wishlist.active svg path,
    #ProductSection-{{ section.id }} .final-wishlist-fix .js-btn-wishlist.added svg path {
        fill: #000000 !important;
        stroke: #000000 !important;
    }

    /* 3. FontAwesome "currentColor" Override (The crucial fix for your app) */
    #ProductSection-{{ section.id }} .final-wishlist-fix .js-btn-wishlist:hover,
    #ProductSection-{{ section.id }} .final-wishlist-fix .js-btn-wishlist.is-active,
    #ProductSection-{{ section.id }} .final-wishlist-fix .js-btn-wishlist.active,
    #ProductSection-{{ section.id }} .final-wishlist-fix .js-btn-wishlist.added {
        color: #000000 !important; 
    }
</style>

<div class="product-block product-title final-wishlist-fix">

  <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
    {% if settings.enable_wishlsit %}
      <span 
  class="js-btn-wishlist" 
  title="Wishlist" 
  data-handle="{{ product.handle }}"
  data-product-handle="{{ product.handle }}"
  data-product-id="{{ product.id }}"
  style="cursor: pointer;"
>
  <svg class="icon icon-heart-outline" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
  </svg>
</span>
    {% endif %}
{%- comment -%} START: Metafield Badge Logic {%- endcomment -%}
    {%- assign metafield_badge = product.metafields.custom.product_badge_text -%}
    
    {%- if metafield_badge != blank or block.settings.badge_text != blank -%}
      <span class="custom-product-badge" style="background-color: {{ block.settings.badge_bg_color }}; color: {{ block.settings.badge_text_color }}; padding: 4px 10px; font-size: 11px; letter-spacing: 0.5px; font-weight: 600; border-radius: 15px; line-height: 1; text-transform: uppercase;">
        {%- if metafield_badge != blank -%}
          {{ metafield_badge }}
        {%- else -%}
          {{ block.settings.badge_text }}
        {%- endif -%}
      </span>
    {%- endif -%}
    {%- comment -%} END: Metafield Badge Logic {%- endcomment -%}
   
  </div>


  {%- if block.settings.e_label -%}
    <div style="margin-bottom: 8px;">
      {% render 'product-label' %}
    </div>
  {%- endif -%}
  
<h1 itemprop="name" class="product-single__title" style="
      font-family: 'Montserrat', sans-serif !important;
      font-weight: 600 !important;
      color: #000000 !important; /* CHANGED TO PURE BLACK */
      text-transform: uppercase !important;
      font-size: {{ block.settings.title_font_size }}px; 
      margin: 0 0 5px 0;">
    {{ product.title }}
  </h1>
 {%- comment -%} START: Subtitle / K2 Sphere Text {%- endcomment -%}
  {%- assign metafield_subtitle = product.metafields.custom.product_subtitle -%}
  {%- assign subtitle_text = metafield_subtitle | default: block.settings.subtitle_text -%}
  
  {%- if subtitle_text != blank -%}
  <p class="product-subtitle" style="
      font-size: {{ block.settings.subtitle_font_size }}px; 
      font-weight: {{ block.settings.subtitle_font_weight }}; 
      color: {{ block.settings.subtitle_color }}; 
      margin-top: 5px; 
      margin-bottom: 15px; 
      line-height: 1.2;
      text-transform: none !important; /* CHANGED: Respects your input case */
      letter-spacing: 0.5px;">
      {{ subtitle_text }}
    </p>
  {%- endif -%}
  {%- comment -%} END: Subtitle / K2 Sphere Text {%- endcomment -%}
  
  {% if block.settings.show_vendor %}
    <p class="product-vendor" style="font-size: {{ block.settings.vendor_font_size }}px; font-weight: {{ block.settings.vendor_font_weight }}; margin-top: 5px; margin-bottom: 10px; color: #555;">
      {{ product.vendor }}
    </p>
  {% endif %}
</div>
            {%- when 'shortdesc' -%}
              {% if product.metafields.info.shortdesc != blank %}
              <div class="product-block rte product-short__description txt-body-70" >
                {{ product.metafields.info.shortdesc }}
              </div>
              {% endif %}
     {%- when 'description' -%}
  {%- comment -%} --- FONT LOADING & STYLING START --- {%- endcomment -%}
  {%- assign content_font = block.settings.desc_font_family -%}
  {%- assign title_font = block.settings.tab_header_font_family -%}
  
  <style>
    /* 1. Load font files */
    {{ content_font | font_face: font_display: 'swap' }}
    {{ title_font | font_face: font_display: 'swap' }}

    /* 2. Tab Titles (Montserrat Semi-Bold 600) */
    .custom-product-tabs .tab-link {
      font-family: 'Montserrat', sans-serif !important;
      font-weight: 600 !important;
      font-size: {{ block.settings.tab_header_font_size }}px !important;
      color: #999 !important;
      transition: color 0.3s ease;
      text-transform: uppercase !important;
      letter-spacing: 0.5px !important;
    }
    
    /* Active State */
    .custom-product-tabs .tab-link.active {
      color: #000000 !important;
      text-decoration-color: #000000 !important;
    }

    /* 3. Content (Montserrat Regular 400) */
    .custom-product-tabs .tab-content-item,
    .custom-product-tabs .tab-content-item p,
    .custom-product-tabs .tab-content-item li,
    .custom-product-tabs .tab-content-item span,
    .custom-product-tabs .tab-content-item div {
      font-family: 'Montserrat', sans-serif !important;
      font-weight: 400 !important;
      font-size: {{ block.settings.desc_font_size }}px !important;
      line-height: 1.6 !important;
      color: #333 !important;
    }
    
    /* List fixes */
    .custom-product-tabs .tab-content-item ul {
      padding-left: 20px !important;
      list-style-type: disc !important;
      margin: 10px 0 !important;
    }
    .custom-product-tabs .tab-content-item li {
      margin-bottom: 5px !important;
    }
  </style>

  <div class="size-guide-new-style" style="margin-bottom: 30px; text-align: left; line-height: 1.6;">
    
    <div style="margin-bottom: 5px; font-size: 14px; color: #000; font-family: 'Montserrat', sans-serif !important;">
      <span style="font-weight: 600; margin-right: 5px;">Size:</span>
      
      {%- assign product_size_guide_image = product.metafields.custom.size_guide_image | default: section.settings.sizeguide_image -%}
      {%- if product_size_guide_image != blank -%}
        <a class="js-open-size-guide size-guide-modal-opener" 
           data-handle="{{ product.handle }}" 
           style="text-decoration: underline; text-underline-offset: 3px; cursor: pointer; color: #555; font-weight: 400;">
          Size Guide
        </a>
        {%- render 'productSizeGuide', sizeguide_image: product_size_guide_image -%}
      {%- endif -%}
    </div>
    
    </div>

<div style="display: none !important; font-size: 12px; letter-spacing: 0.5px; margin-bottom: 25px !important;">
        <span style="font-weight: 700; text-transform: uppercase; color: #000; margin-right: 5px;">FIT PREDICTOR:</span>
      <span style="color: #666;">calculate your size</span>
    </div>
    
  </div>
  <div class="custom-product-tabs">
    <ul class="tabs-header">
      <li class="tab-link active" onclick="openTab(event, 'tab-description')">Description</li>
      <li class="tab-link" onclick="openTab(event, 'tab-sizefit')">Size & Fit</li>
      <li class="tab-link" onclick="openTab(event, 'tab-brand')">About the Brand</li>
    </ul>

    <div id="tab-description" class="tab-content-item active">
      {{ product.description }}
    </div>

    <div id="tab-sizefit" class="tab-content-item">
      {% if product.metafields.custom.size_and_fit != blank %}
        {{ product.metafields.custom.size_and_fit | metafield_tag }}
      {% else %}
        <p>Model is wearing size S. <br>Height: 5'9"</p>
      {% endif %}
    </div>

    <div id="tab-brand" class="tab-content-item">
      {% if product.metafields.custom.about_the_brand != blank %}
        {{ product.metafields.custom.about_the_brand | metafield_tag }}
      {% else %}
        <p>Information about the brand goes here.</p>
      {% endif %}
    </div>
  </div>
  
  <script>
    function openTab(evt, tabName) {
      var i, tabcontent, tablinks;
      // Hide all tab content
      tabcontent = document.getElementsByClassName("tab-content-item");
      for (i = 0; i < tabcontent.length; i++) {
        tabcontent[i].className = tabcontent[i].className.replace(" active", "");
      }
      // Remove active class from all tab links
      tablinks = document.getElementsByClassName("tab-link");
      for (i = 0; i < tablinks.length; i++) {
        tablinks[i].className = tablinks[i].className.replace(" active", "");
      }
      // Show the current tab and add an "active" class to the button that opened the tab
      document.getElementById(tabName).className += " active";
      evt.currentTarget.className += " active";
    }
  </script>
