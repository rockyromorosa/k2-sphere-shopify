    <img width="auto" height="auto" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="  loading="lazy" id="ProductZoomImg" class="product-modal__image">
  </div>
  <button type="button" class="modal__close js-modal-close text-link">
    {%- render 'icon-close' -%}
  </button>
</div>
{% unless product == empty %}
<script type="application/json" id="ProductJson-{{ section.id }}">
    {{ product | json }}
</script>
{% if section.settings.stock_enable %}
<script type="application/json" id="VariantJson-{{ section.id }}">
      [
        {% for variant in product.variants %}
          {
             "incoming": {{ variant.incoming | default: false | json }},
             "next_incoming_date": {{ variant.next_incoming_date | date: format: 'month_day_year' | json }},
             "inventory_policy": {{ variant.inventory_policy | json }},
             "inventory_quantity": {{ variant.inventory_quantity | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
</script>
{% endif %}
{% endunless %}

<script>
  // Override default values of shop.strings for each template.
  // Alternate product templates can change values of
  // add to cart button, sold out, and unavailable states here.
  window.productStrings = {
    addToCart: {{ "ADD TO BAG" | json }},
    soldOut: {{ 'products.product.sold_out' | t | json }},
    unavailable: {{ 'products.product.unavailable' | t | json }}
  }
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const productSection = document.querySelector('#ProductSection-{{ section.id }}');
  if (!productSection) return;

  const mainGallery = productSection.querySelector('.my-gallery');
  const thumbGallery = productSection.querySelector('.product-single__thumbnails');
  if (!mainGallery) return;

  const productHandle = "{{ product.handle }}";
  if (!productHandle || productHandle === "null" || productHandle === "") return;

  // 1. GET URL FROM FILE PICKER METAFIELD
  {% assign forced_video = product.metafields.custom.forced_video_file.value %}
  {% assign forced_url = forced_video.sources[0].url | default: '' %}
  
  const FORCED_METAFIELD_URL = "{{ forced_url }}";

  // Helper to extract unique ID from Shopify CDN link
  const getCleanID = (url) => {
    if (!url) return '';
    let clean = url.split('?')[0];
    const parts = clean.split('/');
    for (const part of parts) {
        if (part.length > 15 && /^[a-z0-9]+$/i.test(part)) {
            return part;
        }
    }
    return clean; 
  };

  fetch(`/products/${productHandle}.js`)
    .then(response => response.json())
    .then(product => {
      const colorOption = product.options.find(option => option.name.toLowerCase().includes('color'));
      if (!colorOption) return;

      const mediaIdToPositionMap = new Map();
      let forcedVideoMediaId = null;
      
      const targetHash = getCleanID(FORCED_METAFIELD_URL);
      
      console.log('Targeting Video Hash:', targetHash);

      product.media.forEach(media => {
        mediaIdToPositionMap.set(media.id, media.position);
        
        if (media.media_type === 'video' || media.media_type === 'external_video') {
          const sources = media.sources || [];
          const hasMatchingUrl = targetHash !== "" && sources.some(source => 
             source.url && source.url.indexOf(targetHash) !== -1
          );

          if (hasMatchingUrl) {
            forcedVideoMediaId = media.id;
            console.log('🎥 MATCH FOUND! Forced Video ID:', forcedVideoMediaId);
          }
        }
      });

      // Define Color Ranges (Group Images)
      const colorPositionMap = {};
      product.variants.forEach(variant => {
        const colorValue = variant.options[colorOption.position - 1];
        if (variant.featured_image && !colorPositionMap[colorValue]) {
          const mediaId = variant.featured_image.id;
          if (mediaId !== forcedVideoMediaId) {
            colorPositionMap[colorValue] = variant.featured_image.position;
          }
        }
      });

      const sortedColors = Object.entries(colorPositionMap).sort((a, b) => a[1] - b[1]);
      const colorImageRanges = {};
      sortedColors.forEach(([color, startPos], index) => {
        const nextColor = sortedColors[index + 1];
        const endPos = nextColor ? nextColor[1] : product.media.length + 1;
        colorImageRanges[color] = { start: startPos, end: endPos, featurePos: startPos };
      });

      const getSelectedVariant = () => {
        const variantIdInput = productSection.querySelector('input[name="id"]:checked, select[name="id"], input[name="id"][type="hidden"]');
        if (variantIdInput && variantIdInput.value) {
          return product.variants.find(v => v.id == variantIdInput.value);
        }
        const form = productSection.querySelector('form[action*="/cart/add"]');
        if (!form) return product.variants[0];

        const selectedOptions = [];
        for (let i = 1; i <= 3; i++) {
          const optionInput = form.querySelector(`input[name="option${i}"]:checked`) || 
                              form.querySelector(`select[name="option${i}"]`) ||
                              form.querySelector(`input[name="option${i}"]`);
          if (optionInput) {
            selectedOptions.push(optionInput.value);
          }
        }
        return product.variants.find(variant => {
          return variant.options.every((option, index) => option === selectedOptions[index]);
        }) || product.variants[0];
      };

      const updateVariantImages = (forcedVariant = null) => {
        const selectedVariant = forcedVariant || getSelectedVariant();
        if (!selectedVariant) return;

        const selectedColor = selectedVariant.options[colorOption.position - 1];
        const range = colorImageRanges[selectedColor];

        if (!range) return;

        // --- UPDATED FILTER SLIDER FUNCTION STARTS HERE ---
        const filterSlider = (slider) => {
          if (!slider || typeof $ === 'undefined' || !$(slider).hasClass('slick-initialized')) return;
          
          $(slider).slick('slickUnfilter');

          let visibleSlideCount = 0;
          let featuredImageSlideIndex = 0;

          $(slider).slick('slickFilter', function(index) {
            const slide = this;
            const mediaId = parseInt(slide.dataset.imageId, 10);
            if (isNaN(mediaId)) return false;

            // FORCE VIDEO VISIBILITY HERE
            if (mediaId === forcedVideoMediaId) {
              return true;
            }

            const currentPosition = mediaIdToPositionMap.get(mediaId);
            const isVisible = currentPosition >= range.start && currentPosition < range.end;

            if (isVisible) {
              if (currentPosition === range.featurePos) {
                featuredImageSlideIndex = visibleSlideCount;
              }
              visibleSlideCount++;
            }
            return isVisible;
          });

          // Manage arrows visibility
          const arrows = slider.querySelectorAll('.slick-arrow');
          arrows.forEach(arrow => {
            if (visibleSlideCount <= 1) {
              arrow.classList.add('is-hidden');
            } else {
              arrow.classList.remove('is-hidden');
            }
          });

          // --- LOGIC TO KEEP SLIDE POSITION ---
          if (visibleSlideCount > 0) {
            // Default target is the first image of the color
            let targetIndex = featuredImageSlideIndex;

            // If we are on the main gallery and have a saved position, use it
            if (slider === mainGallery && typeof window.savedRelativeIndex !== 'undefined') {
               targetIndex = window.savedRelativeIndex;

               // Safety check: if new color has fewer images than where we were, go to last available
               if (targetIndex >= visibleSlideCount) {
                  targetIndex = visibleSlideCount - 1;
               }
            }
            
            $(slider).slick('slickGoTo', targetIndex); 
          }
          // --- END LOGIC ---
          
          $(slider).slick('refresh');
          $(slider).slick('setPosition');
        };
        // --- UPDATED FILTER SLIDER FUNCTION ENDS HERE ---

        filterSlider(mainGallery);
        if (thumbGallery) filterSlider(thumbGallery);
      };

      // Event Listeners
      productSection.addEventListener('variant:changed', (event) => {
        if (event.detail && event.detail.variant) {
          setTimeout(() => updateVariantImages(event.detail.variant), 50);
        }
      });

      productSection.addEventListener('click', (event) => {
        if (event.target.matches('input[name*="option"]') || event.target.matches('label[for*="option"]')) {
            setTimeout(() => updateVariantImages(), 100);
            setTimeout(() => updateVariantImages(), 400);
        }
      });

      productSection.addEventListener('change', (event) => {
        if (event.target.matches('input[name*="option"], select[name*="option"]')) {
          setTimeout(() => updateVariantImages(), 100);
        }
      });

      const initializeGallery = () => {
        const checkAndInit = () => {
          const mainReady = typeof $ !== 'undefined' && $(mainGallery).hasClass('slick-initialized');
          const thumbReady = !thumbGallery || (typeof $ !== 'undefined' && $(thumbGallery).hasClass('slick-initialized'));

         if (mainReady && thumbReady) {
            // --- FIX: Increase Thumbnail Limit from 5 to 8 ---
            if (thumbReady && thumbGallery && typeof $ !== 'undefined') {
                $(thumbGallery).slick('slickSetOption', 'slidesToShow', 8, true);
            }
            // -------------------------------------------------

            // --- START: TRACK CURRENT SLIDE INDEX ---
            if (typeof $ !== 'undefined' && !window.sliderTrackerAdded) {
               $(mainGallery).off('afterChange.tracker').on('afterChange.tracker', function(event, slick, currentSlide) {
                  // Save the index (0, 1, 2...) whenever the user moves the slider
                  window.savedRelativeIndex = currentSlide;
               });
               window.sliderTrackerAdded = true;
            }
            // --- END: TRACK CURRENT SLIDE INDEX ---

            updateVariantImages();
          } else {
            setTimeout(checkAndInit, 200);
          }
        };
        checkAndInit();
      };

      setTimeout(initializeGallery, 300);
      setTimeout(initializeGallery, 600);
    });
});
</script>
<script>
// --- 1. GLOBAL VARIABLES ---
if (typeof window.stickyIndex === 'undefined') {
    window.stickyIndex = 0; 
}
window.isSwitching = false;
window.switchingTimeout = null;
window.thumbnailEnforcer = null;

document.addEventListener('DOMContentLoaded', () => {
    const productSection = document.querySelector('#ProductSection-{{ section.id }}');
    if (!productSection) return;

    const mainGallery = productSection.querySelector('.my-gallery');
    const thumbGallery = productSection.querySelector('.product-single__thumbnails');
    if (!mainGallery) return;

    const productHandle = "{{ product.handle }}";
    if (!productHandle) return;

    {% assign forced_video = product.metafields.custom.forced_video_file.value %}
    {% assign forced_url = forced_video.sources[0].url | default: '' %}
    const FORCED_METAFIELD_URL = "{{ forced_url }}";

    const getCleanID = (url) => {
        if (!url) return '';
        let clean = url.split('?')[0];
        const parts = clean.split('/');
        for (const part of parts) {
            if (part.length > 15 && /^[a-z0-9]+$/i.test(part)) return part;
        }
        return clean; 
    };

    fetch(`/products/${productHandle}.js`)
    .then(response => response.json())
    .then(product => {
        const colorOption = product.options.find(option => option.name.toLowerCase().includes('color'));
        if (!colorOption) return;

        const mediaIdToPositionMap = new Map();
        let forcedVideoMediaId = null;
        const targetHash = getCleanID(FORCED_METAFIELD_URL);
        
        product.media.forEach(media => {
            mediaIdToPositionMap.set(media.id, media.position);
            if (media.media_type === 'video' || media.media_type === 'external_video') {
                const sources = media.sources || [];
                if (targetHash !== "" && sources.some(s => s.url && s.url.indexOf(targetHash) !== -1)) {
                    forcedVideoMediaId = media.id;
                }
            }
        });

        const colorPositionMap = {};
        product.variants.forEach(variant => {
            const colorValue = variant.options[colorOption.position - 1];
            if (variant.featured_image && !colorPositionMap[colorValue]) {
                if (variant.featured_image.id !== forcedVideoMediaId) {
                    colorPositionMap[colorValue] = variant.featured_image.position;
                }
            }
        });

        const sortedColors = Object.entries(colorPositionMap).sort((a, b) => a[1] - b[1]);
        const colorImageRanges = {};
        sortedColors.forEach(([color, startPos], index) => {
            const nextColor = sortedColors[index + 1];
            const endPos = nextColor ? nextColor[1] : product.media.length + 1;
            colorImageRanges[color] = { start: startPos, end: endPos, featurePos: startPos };
        });

        const updateVariantImages = (forcedVariant = null) => {
            // --- SMOOTHING: CLEAR ALL PENDING ACTIONS ---
            if (window.switchingTimeout) clearTimeout(window.switchingTimeout);
            if (window.thumbnailEnforcer) clearInterval(window.thumbnailEnforcer);
            
            window.isSwitching = true; 

            const selectedVariant = forcedVariant || (function() {
                const variantIdInput = productSection.querySelector('input[name="id"]:checked, select[name="id"], input[name="id"][type="hidden"]');
                return product.variants.find(v => v.id == (variantIdInput ? variantIdInput.value : null)) || product.variants[0];
            })();

            const selectedColor = selectedVariant.options[colorOption.position - 1];
            const range = colorImageRanges[selectedColor];
            if (!range) return;

            const filterSlider = (slider) => {
                if (!slider || typeof $ === 'undefined' || !$(slider).hasClass('slick-initialized')) return;
                
                $(slider).slick('slickUnfilter');
                let visibleSlideCount = 0;

                $(slider).slick('slickFilter', function() {
                    const mediaId = parseInt(this.dataset.imageId, 10);
                    if (mediaId === forcedVideoMediaId) return true;
                    const pos = mediaIdToPositionMap.get(mediaId);
                    const isVisible = pos >= range.start && pos < range.end;
                    if (isVisible) visibleSlideCount++;
                    return isVisible;
                });

                if (visibleSlideCount > 0) {
                    let target = window.stickyIndex;
                    if (target >= visibleSlideCount) target = visibleSlideCount - 1;
                    if (target < 0) target = 0;
                    
                    $(slider).slick('slickGoTo', target, true); 

                    if (slider === thumbGallery) {
                        // Enforce highlight smoothly
                        window.thumbnailEnforcer = setInterval(() => {
                            const $slides = $(slider).find('.slick-slide:not(.slick-cloned)').filter(':visible');
                            const $target = $($slides[target]);
                            if ($target.length && !$target.hasClass('slick-current')) {
                                $slides.removeClass('slick-current slick-active');
                                $target.addClass('slick-current slick-active');
                            }
                        }, 40); 
                    }
                }
                $(slider).slick('setPosition');
            };

            filterSlider(mainGallery);
            if (thumbGallery) filterSlider(thumbGallery);

            window.switchingTimeout = setTimeout(() => {
                window.isSwitching = false;
                if (window.thumbnailEnforcer) clearInterval(window.thumbnailEnforcer);
            }, 500); // Shorter lock time for responsiveness
        };

        // --- ATTACH LISTENERS ---
        document.addEventListener('click', (e) => {
            if (e.target.closest('.single-option-radio') || e.target.closest('select.single-option-selector')) {
                // Short delay to let the input register, then force the update
                setTimeout(() => updateVariantImages(), 10);
            }
        }, true);

        productSection.addEventListener('variant:changed', (e) => {
            if (e.detail && e.detail.variant) updateVariantImages(e.detail.variant);
        });

        const initializeGallery = () => {
            const check = () => {
                const mainReady = typeof $ !== 'undefined' && $(mainGallery).hasClass('slick-initialized');
                const thumbReady = !thumbGallery || ($(thumbGallery).hasClass('slick-initialized'));

                if (mainReady && thumbReady) {
                    if (thumbGallery) $(thumbGallery).slick('slickSetOption', 'slidesToShow', 8, true);

                    if (!window.trackerActive) {
                        $(mainGallery).on('afterChange', (e, s, curr) => {
                            if (!window.isSwitching) window.stickyIndex = curr;
                        });
                        window.trackerActive = true;
                    }
                    updateVariantImages();
                } else {
                    setTimeout(check, 100);
                }
            };
            check();
        };

        setTimeout(initializeGallery, 100);
    });
});
</script>

