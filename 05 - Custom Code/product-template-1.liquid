                <div class="js-contac t-soldout {% if current_variant.available %}hide{% endif %}">
                  <span class="btn btn-waitlist btn-theme" data-toggle="modal" data-target="#jsSoldout" title="{{ 'products.product.soldout_messenger' | t }}">{{ 'products.product.waitlist' | t }}</span>
                </div>
                {%- endif -%}
              <script>
document.addEventListener('DOMContentLoaded', function () {
  const buyNowBtn = document.getElementById('fixed-buy-now');
  if (!buyNowBtn) return;

  buyNowBtn.addEventListener('click', function (e) {
    e.preventDefault();
    e.stopPropagation();
    if (e.stopImmediatePropagation) e.stopImmediatePropagation();

    const form = buyNowBtn.closest('form');
    if (!form) return;

    const idInput = form.querySelector('[name="id"]');
    const qtyInput = form.querySelector('[name="quantity"]');

    const variantId = idInput ? idInput.value : '';
    const qty = qtyInput ? qtyInput.value : 1;

    if (!variantId) return;

    window.location.href = '/cart/' + variantId + ':' + qty;
  });
});
</script>
