<script>
document.addEventListener('DOMContentLoaded', function () {

  const signatureObservers = new WeakMap();


  function setImportant(element, property, value) {
    if (!element) return;

    element.style.setProperty(
      property,
      value,
      'important'
    );
  }


  /* =========================================================
     SIGNATURE
     ========================================================= */

  function lockSignatureCanvas(canvas) {

    setImportant(canvas, 'width', '500px');
    setImportant(canvas, 'max-width', '100%');

    setImportant(canvas, 'height', '200px');
    setImportant(canvas, 'min-height', '200px');
    setImportant(canvas, 'max-height', '200px');

    setImportant(canvas, 'display', 'block');
    setImportant(canvas, 'margin', '0');
    setImportant(canvas, 'padding', '0');

    setImportant(
      canvas,
      'border',
      '1px solid #dddddd'
    );

    setImportant(
      canvas,
      'border-radius',
      '5px'
    );

    setImportant(
      canvas,
      'box-shadow',
      'none'
    );

    setImportant(
      canvas,
      'background',
      '#ffffff'
    );


    const signatureField =
      canvas.closest('.signature-field');


    if (signatureField) {

      setImportant(
        signatureField,
        'width',
        '500px'
      );

      setImportant(
        signatureField,
        'max-width',
        '100%'
      );

      setImportant(
        signatureField,
        'border',
        '0'
      );

      setImportant(
        signatureField,
        'outline',
        '0'
      );

      setImportant(
        signatureField,
        'box-shadow',
        'none'
      );

      setImportant(
        signatureField,
        'background',
        'transparent'
      );

      setImportant(
        signatureField,
        'padding',
        '0'
      );

      setImportant(
        signatureField,
        'margin',
        '0'
      );


      const inputWrapper =
        signatureField.closest('.form-field_input');


      if (inputWrapper) {

        setImportant(
          inputWrapper,
          'width',
          '500px'
        );

        setImportant(
          inputWrapper,
          'max-width',
          '100%'
        );

        setImportant(
          inputWrapper,
          'border',
          '0'
        );

        setImportant(
          inputWrapper,
          'outline',
          '0'
        );

        setImportant(
          inputWrapper,
          'box-shadow',
          'none'
        );

        setImportant(
          inputWrapper,
          'background',
          'transparent'
        );

        setImportant(
          inputWrapper,
          'padding',
          '0'
        );
      }
    }


    if (!signatureObservers.has(canvas)) {

      const observer =
        new MutationObserver(function () {

          if (
            canvas.style.getPropertyValue('width') !== '500px' ||
            canvas.style.getPropertyValue('height') !== '200px'
          ) {
            lockSignatureCanvas(canvas);
          }

        });


      observer.observe(
        canvas,
        {
          attributes: true,
          attributeFilter: ['style']
        }
      );


      signatureObservers.set(
        canvas,
        observer
      );
    }
  }



  /* =========================================================
     MAIN
     ========================================================= */

  function styleOptisForm(root) {


    /* =========================================================
   1. COLOR SWATCHES - FORCE SAME SIZE EVEN WHEN SELECTED
   ========================================================= */

root.querySelectorAll('.form-field')
