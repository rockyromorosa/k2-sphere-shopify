<script>
(function () {

  const MOBILE_QUERY = window.matchMedia('(max-width: 767px)');
  const TITLE_TEXT =
    'Creator Onboarding and Intellectual Property Agreement';

  let activeRoot = null;
  let widthObserver = null;
  let swatchObserver = null;

  let swatchApplying = false;
  let swatchScheduled = false;


  function setImportant(el, property, value) {
    if (!el) return;

    el.style.setProperty(
      property,
      value,
      'important'
    );
  }


  function setIfDifferent(el, property, value) {
    if (!el) return;

    if (
      el.style.getPropertyValue(property) !== value ||
      el.style.getPropertyPriority(property) !== 'important'
    ) {
      el.style.setProperty(
        property,
        value,
        'important'
      );
    }
  }


  /* =========================================================
     MOBILE WIDTH / OVERFLOW
     ========================================================= */

  function fixMobileWidth(host, root) {

    if (!MOBILE_QUERY.matches) return;

    setImportant(host, 'display', 'block');
    setImportant(host, 'width', '100%');
    setImportant(host, 'max-width', '100%');
    setImportant(host, 'min-width', '0');
    setImportant(host, 'box-sizing', 'border-box');


    if (!root.querySelector('#k2-mobile-width-style')) {

      const style =
        document.createElement('style');

      style.id =
        'k2-mobile-width-style';

      style.textContent = `
        @media (max-width: 767px) {

          :host {
            display: block !important;
            width: 100% !important;
            max-width: 100% !important;
            min-width: 0 !important;
            box-sizing: border-box !important;
          }

          form,
          fieldset {
            width: 100% !important;
            max-width: 100% !important;
            min-width: 0 !important;
            box-sizing: border-box !important;
          }

          input,
          select,
          textarea {
            width: 100% !important;
            max-width: 100% !important;
            min-width: 0 !important;
            box-sizing: border-box !important;
          }

          label,
          p,
          li,
          span {
            max-width: 100% !important;
            white-space: normal !important;
            overflow: visible !important;
            text-overflow: clip !important;
            overflow-wrap: anywhere !important;
            word-break: normal !important;
          }

        }
      `;

      root.appendChild(style);
    }


    const hostRect =
      host.getBoundingClientRect();


    root.querySelectorAll('*')
      .forEach(function (el) {

        const rect =
          el.getBoundingClientRect();

        if (
          rect.width > hostRect.width + 2 ||
          rect.right > hostRect.right + 2
        ) {

          let node = el;
          let levels = 0;

          while (
            node &&
            levels < 6
          ) {

            setImportant(
              node,
              'max-width',
              '100%'
            );

            setImportant(
              node,
              'min-width',
              '0'
            );

            setImportant(
              node,
              'box-sizing',
              'border-box'
            );


            const display =
              getComputedStyle(node).display;

            if (
              display === 'block' ||
              display === 'flex' ||
              display === 'grid' ||
              node.matches(
                'input, select, textarea, fieldset'
              )
            ) {

              setImportant(
                node,
                'width',
                '100%'
              );
            }

            node =
              node.parentElement;

            levels++;
          }
        }
      });
  }


  /* =========================================================
     TITLE → FORM SPACING
     ========================================================= */

  function fixMobileSpacing(host, root) {

    if (!MOBILE_QUERY.matches) return;


    const heading =
      Array.from(
        document.querySelectorAll(
          'h1,h2,h3,h4,h5,h6,p,div,span'
        )
      ).find(function (el) {

        return (
          (el.textContent || '').trim()
          === TITLE_TEXT
        );
      });


    if (!heading) return;


    function clearBottom(el) {

      if (
        !el ||
        el.nodeType !== 1
      ) return;


      const css =
        getComputedStyle(el);


      if (parseFloat(css.marginBottom) > 20) {
        setImportant(
          el,
          'margin-bottom',
          '0px'
        );
      }


      if (parseFloat(css.paddingBottom) > 20) {
        setImportant(
          el,
          'padding-bottom',
          '0px'
        );
      }
    }


    function clearTop(el) {

      if (
        !el ||
        el.nodeType !== 1
      ) return;


      const css =
        getComputedStyle(el);


      if (parseFloat(css.marginTop) > 20) {
        setImportant(
          el,
          'margin-top',
          '0px'
        );
      }


      if (parseFloat(css.paddingTop) > 20) {
        setImportant(
          el,
          'padding-top',
          '0px'
        );
      }
    }


    let node = heading;

    for (
      let i = 0;
      node && i < 6;
      i++
    ) {

      clearBottom(node);

      node =
        node.parentElement;
    }


    node = host;

    for (
      let i = 0;
      node && i < 6;
      i++
    ) {

      clearTop(node);

      node =
        node.parentElement;
    }


    const firstField =
      root.querySelector(
        'input, select, textarea'
      );


    if (firstField) {

      node = firstField;

      for (
        let i = 0;
        node && i < 8;
        i++
      ) {

        clearTop(node);

        node =
          node.parentElement;
      }
    }
  }


  /* =========================================================
     SWATCH HARD LOCK
     EXACT CONSOLE-TESTED 6 + 2 FIX
     ========================================================= */

  function lockSwatches(root) {

    if (
      !MOBILE_QUERY.matches ||
      swatchApplying
    ) {
      return;
    }


    swatchApplying = true;


    const swatches =
      Array.from(
        root.querySelectorAll(
          '.image-choice-option'
        )
      );


    if (!swatches.length) {

      swatchApplying = false;
      return;
    }


    swatches.forEach(function (swatch) {

      setIfDifferent(
        swatch,
        'width',
        '30px'
      );

      setIfDifferent(
        swatch,
        'height',
        '30px'
      );

      setIfDifferent(
        swatch,
        'min-width',
        '30px'
      );

      setIfDifferent(
        swatch,
        'max-width',
        '30px'
      );

      setIfDifferent(
        swatch,
        'min-height',
        '30px'
      );

      setIfDifferent(
        swatch,
        'max-height',
        '30px'
      );

      setIfDifferent(
        swatch,
        'flex',
        'none'
      );

      setIfDifferent(
        swatch,
        'box-sizing',
        'border-box'
      );

    });


    const row =
      swatches[0].parentElement;


    if (row) {

      setIfDifferent(
        row,
        'display',
        'grid'
      );

      setIfDifferent(
        row,
        'grid-template-columns',
        'repeat(6, 30px)'
