      setIfDifferent(
        row,
        'grid-auto-flow',
        'row'
      );

      setIfDifferent(
        row,
        'gap',
        '8px'
      );

      setIfDifferent(
        row,
        'width',
        '220px'
      );

      setIfDifferent(
        row,
        'max-width',
        '100%'
      );

      setIfDifferent(
        row,
        'min-width',
        '0'
      );

      setIfDifferent(
        row,
        'overflow',
        'visible'
      );

      setIfDifferent(
        row,
        'justify-content',
        'start'
      );

      setIfDifferent(
        row,
        'box-sizing',
        'border-box'
      );

    }


    swatchApplying = false;
  }


  function scheduleSwatchLock(root) {

    if (swatchScheduled) return;


    swatchScheduled = true;


    requestAnimationFrame(function () {

      swatchScheduled = false;

      lockSwatches(root);

    });
  }


  /* =========================================================
     INITIALIZE
     ========================================================= */

  function initializeK2Mobile() {

    if (!MOBILE_QUERY.matches) {
      return false;
    }


    const host =
      document.querySelector(
        'dynamic-form'
      );


    if (
      !host ||
      !host.shadowRoot
    ) {
      return false;
    }


    const root =
      host.shadowRoot;


    fixMobileWidth(
      host,
      root
    );

    fixMobileSpacing(
      host,
      root
    );

    lockSwatches(
      root
    );


    if (activeRoot !== root) {

      activeRoot = root;


      if (widthObserver) {
        widthObserver.disconnect();
      }


      if (swatchObserver) {
        swatchObserver.disconnect();
      }


      widthObserver =
        new MutationObserver(function () {

          if (MOBILE_QUERY.matches) {

            fixMobileWidth(
              host,
              root
            );
          }

        });


      widthObserver.observe(
        root,
        {
          childList: true,
          subtree: true
        }
      );


      /*
        IMPORTANT:
        Watch style/class changes because
        OPTIS rewrites them after rendering.
      */
      const swatchObserverConfig = {
  childList: true,
  subtree: true,
  attributes: true,
  attributeFilter: [
    'style',
    'class'
  ]
};

swatchObserver =
  new MutationObserver(function () {

    if (
      !MOBILE_QUERY.matches ||
      swatchApplying
    ) {
      return;
    }

    /* Prevent our own changes from causing a loop */
    swatchObserver.disconnect();

    lockSwatches(root);

    requestAnimationFrame(function () {

      lockSwatches(root);

      swatchObserver.observe(
        root,
        swatchObserverConfig
      );

    });

  });

swatchObserver.observe(
  root,
  swatchObserverConfig
);


      function relock() {

        lockSwatches(root);


        setTimeout(
          function () {
            lockSwatches(root);
          },
          50
        );


        setTimeout(
          function () {
            lockSwatches(root);
          },
          200
        );
      }


      root.addEventListener(
        'change',
        relock,
        true
      );


      root.addEventListener(
        'click',
        relock,
        true
      );
    }


    lockSwatches(root);


    setTimeout(
      function () {
        lockSwatches(root);
      },
      100
    );


    setTimeout(
      function () {
        lockSwatches(root);
      },
      500
    );


    console.log(
      'K2 MOBILE HARD LOCK ACTIVE'
    );


    return true;
  }


  function startK2Mobile() {

    if (initializeK2Mobile()) {
      return;
    }


    let attempts = 0;


    const timer =
      setInterval(
        function () {

          attempts++;


          if (
            initializeK2Mobile() ||
            attempts >= 80
          ) {

            clearInterval(
              timer
            );
          }

        },
        250
      );
  }


  if (
    document.readyState === 'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      startK2Mobile,
      {
        once: true
      }
    );

  } else {

    startK2Mobile();

  }


  if (MOBILE_QUERY.addEventListener) {

    MOBILE_QUERY.addEventListener(
      'change',
      function () {

        if (MOBILE_QUERY.matches) {
          startK2Mobile();
        }

      }
    );
  }


})();
