(function () {

  const headings = [
    'Content Requirements',
    'FTC Disclosure',
    'Content Delivery',
    'Content Quality',
    'Non-Delivery',
    'Confidentiality',
    'Governing Law'
  ];

  const bodyStarts = [
    'Products must be clearly visible',
    'Content must be authentic',
    'Tag @k2sphere',
    'Include a link to the K2 SPHERE',
    'Content must remain publicly available',
    'Influencer agrees to comply',
    'The Influencer agrees to create',
    'If the Influencer is unable',
    'All submitted content must meet',
    'K2 SPHERE LLC reserves the right',
    'If the Influencer fails to publish',
    'Return of all products',
    'Reimbursement of the full retail value',
    'The Influencer agrees to keep confidential',
    'This Agreement shall be governed'
  ];

  const watchedRoots = new WeakSet();


  function applyAgreementStyles(root) {

    if (!root || !root.querySelectorAll) return;


    root.querySelectorAll(
      'h1,h2,h3,h4,h5,h6,p,li,div,span'
    ).forEach(function (el) {

      const text =
        (el.textContent || '').trim();


      if (!text) return;


      /*
        Only style the deepest element containing
        the actual agreement text.
      */
      const childHasSameText =
        Array.from(el.children || [])
          .some(function (child) {

            return (
              (child.textContent || '').trim()
              === text
            );

          });


      if (childHasSameText) return;


      /* HEADINGS */
      if (headings.includes(text)) {

        el.style.setProperty(
          'font-family',
          "'Montserrat', sans-serif",
          'important'
        );

        el.style.setProperty(
          'font-size',
          '15px',
          'important'
        );

        el.style.setProperty(
          'line-height',
          '1.5',
          'important'
        );

        el.style.setProperty(
          'font-weight',
          '700',
          'important'
        );

        return;
      }


      /* BODY */
      const isBody =
        bodyStarts.some(function (start) {

          return text.startsWith(start);

        });


      if (isBody) {

        el.style.setProperty(
          'font-family',
          "'Montserrat', sans-serif",
          'important'
        );

        el.style.setProperty(
          'font-size',
          '15px',
          'important'
        );

        el.style.setProperty(
          'line-height',
          '1.5',
          'important'
        );

        el.style.setProperty(
          'font-weight',
          '400',
          'important'
        );

      }

    });

  }


  function watchRoot(root) {

    if (
      !root ||
      watchedRoots.has(root)
    ) {
      return;
    }


    watchedRoots.add(root);

    applyAgreementStyles(root);


    const observer =
      new MutationObserver(function () {

        /*
          OPTIS replaced/rebuilt something.
          Correct it immediately.
        */
        applyAgreementStyles(root);

        discoverShadowRoots(root);

      });


    observer.observe(
      root,
      {
        childList: true,
        subtree: true
      }
    );

  }


  function discoverShadowRoots(root) {

    if (
      !root ||
      !root.querySelectorAll
    ) {
      return;
    }


    watchRoot(root);


    root.querySelectorAll('*')
      .forEach(function (el) {

        if (el.shadowRoot) {

          watchRoot(
            el.shadowRoot
          );

          discoverShadowRoots(
            el.shadowRoot
          );

        }

      });

  }


  function agreementExists() {

    let found = false;


    function search(root) {

      if (
        found ||
        !root ||
        !root.querySelectorAll
      ) {
        return;
      }


      root.querySelectorAll('*')
        .forEach(function (el) {

          if (found) return;


          const text =
            (el.textContent || '').trim();


          if (
            text === 'Content Requirements'
          ) {

            found = true;
            return;

          }


          if (el.shadowRoot) {

            search(
              el.shadowRoot
            );

          }

        });

    }


    search(document);

    return found;
  }


  /*
    IMPORTANT:
    OPTIS can create its Shadow DOM well after
    theme.liquid has already executed.

    This timer ONLY searches for the Shadow DOM.
    It does NOT repeatedly change typography.
  */
  let discoveryAttempts = 0;


  const discoveryTimer =
    setInterval(function () {

      discoveryAttempts++;


      discoverShadowRoots(
        document
      );


      /*
        Once the agreement section actually exists,
        apply once more and stop polling.
      */
      if (agreementExists()) {

        discoverShadowRoots(
          document
        );

        clearInterval(
          discoveryTimer
        );

        console.log(
          'K2 OPTIS agreement typography attached.'
        );

        return;
      }


      /*
        Safety stop after 20 seconds.
      */
      if (discoveryAttempts >= 80) {

        clearInterval(
          discoveryTimer
        );

      }

    }, 250);

})();
/* =========================================================
