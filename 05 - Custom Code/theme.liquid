<script>
(function () {
  function hideBrideyCouponBlock() {
    var all = Array.from(document.querySelectorAll('div, section, form'));

    all.forEach(function (el) {
      if (
        el === document.body ||
        el === document.documentElement ||
        el.closest('.header') ||
        el.closest('header')
      ) {
        return;
      }

      var text = (el.innerText || '').toLowerCase();

      if (
        text.includes('list coupon') &&
        text.includes('bridey') &&
        text.includes('coupon code will work on checkout page')
      ) {
        var childrenWithSameText = Array.from(el.children).filter(function (child) {
          var childText = (child.innerText || '').toLowerCase();

          return (
            childText.includes('list coupon') &&
            childText.includes('bridey') &&
            childText.includes('coupon code will work on checkout page')
          );
        });

        if (childrenWithSameText.length === 0) {
          el.classList.add('k2-bridey-hidden');
        }
      }
    });
  }

  document.addEventListener('DOMContentLoaded', hideBrideyCouponBlock);
  window.addEventListener('load', hideBrideyCouponBlock);
  setTimeout(hideBrideyCouponBlock, 500);
  setTimeout(hideBrideyCouponBlock, 1500);
})();
</script>
