  function updateK2SuccessHeading() {

    const heading =
      Array.from(
        document.querySelectorAll(
          'h1, h2, h3, h4, h5, h6, p, div, span'
        )
      ).find(function (el) {

        return (
          (el.textContent || '').trim()
          === HEADING_TEXT
