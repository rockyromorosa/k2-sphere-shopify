<script>
/* K2 Sphere - Restore Sidecart You May Also Like Products */
(function () {
  function formatMoney(cents) {
    if (!cents) return '';
    return '$' + (cents / 100).toFixed(2);
  }

  function restoreSidecartRecommendations() {
    var heading = Array.from(document.querySelectorAll('*')).find(function (el) {
      return el.textContent && el.textContent.trim() === 'You may also like';
    });

    if (!heading) return;

    var existingBox = document.querySelector('#k2-sidecart-recommendations-restore');
if (existingBox) existingBox.remove();

if (window.k2SidecartRecommendationsLoading) return;
window.k2SidecartRecommendationsLoading = true;

    fetch('/cart.js')
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var item = cart.items && cart.items[0];
        if (!item || !item.product_id) return;

        return fetch('/recommendations/products.json?product_id=' + item.product_id + '&limit=6');
      })
      .then(function (r) {
        if (!r) return null;
        return r.json();
      })
      .then(function (data) {
        if (!data || !data.products || !data.products.length) return;

        var box = document.createElement('div');
        box.id = 'k2-sidecart-recommendations-restore';
        box.style.cssText = 'display:block;padding:14px 0 4px;border-bottom:1px solid #eee;';
        function getSidecartRecommendationImage(product) {
  var image = '';

  if (product.featured_image) {
    image = product.featured_image;
  } else if (product.images && product.images.length) {
    image = product.images[0];
  }

  if (!image) return '';

  if (typeof image === 'object') {
    image = image.src || image.url || '';
  }

  if (!image) return '';

  if (image.indexOf('//') === 0) {
    image = 'https:' + image;
  }

  return image;
}
  

   




var shownProducts = [];
var uniqueProducts = data.products.filter(function (product) {
  var key = product.handle || product.id || product.title;

  if (!key || shownProducts.indexOf(key) !== -1) {
    return false;
  }

  shownProducts.push(key);
  return true;
}).slice(0, 3);

uniqueProducts.forEach(function (product) {
  var img = getSidecartRecommendationImage(product);


  var price = formatMoney(product.price);

          box.innerHTML +=
            '<a href="' + product.url + '" style="display:flex;gap:12px;align-items:center;margin-bottom:14px;text-decoration:none;color:inherit;">' +
              (img ? '<img src="' + img + '" style="width:70px;height:90px;object-fit:cover;">' : '') +
              '<div style="flex:1;">' +
                '<div style="font-weight:600;font-size:13px;text-transform:uppercase;color:#000;line-height:18px;">' +
                  product.title +
                '</div>' +
                '<div style="font-size:13px;color:#000;margin-top:4px;">' +
                  price +
                '</div>' +
              '</div>' +
            '</a>';
        });

        heading.insertAdjacentElement('afterend', box);
window.k2SidecartRecommendationsLoading = false;
})
.catch(function () {
  window.k2SidecartRecommendationsLoading = false;
});
  }

  document.addEventListener('DOMContentLoaded', function () {
    setTimeout(restoreSidecartRecommendations, 800);
  });

  document.addEventListener('click', function () {
    setTimeout(restoreSidecartRecommendations, 800);
    setTimeout(restoreSidecartRecommendations, 1500);
  });

  document.addEventListener('cart:updated', function () {
    setTimeout(restoreSidecartRecommendations, 800);
  });
})();
</script>
