/* =========================================================
   K2 SPHERE - PERMANENT OPTIS COLOR SWATCH FIX
   ========================================================= */

function k2FixOptisColorSwatches(root) {

  if (!root || !root.querySelectorAll) return;

  /* DESKTOP ONLY — mobile is handled by the hard-lock mobile script */
  if (window.matchMedia('(max-width: 767px)').matches) {
    return;
  }



  const swatches =
    root.querySelectorAll('.image-choice-option');


  swatches.forEach(function (button) {

    /* KEEP EACH COLOR SWATCH 30x30 */
    button.style.setProperty(
      'width',
      '30px',
      'important'
    );

    button.style.setProperty(
      'height',
      '30px',
      'important'
    );

    button.style.setProperty(
      'min-width',
      '30px',
      'important'
    );

    button.style.setProperty(
      'max-width',
      '30px',
      'important'
    );

    button.style.setProperty(
      'min-height',
      '30px',
      'important'
    );

    button.style.setProperty(
      'max-height',
      '30px',
      'important'
    );

    button.style.setProperty(
      'box-sizing',
      'border-box',
      'important'
    );

    button.style.setProperty(
      'transform',
      'none',
      'important'
    );


    const img =
      button.querySelector('img');


    if (img) {

      img.style.setProperty(
        'width',
        '100%',
        'important'
      );

      img.style.setProperty(
        'height',
        '100%',
        'important'
      );

      img.style.setProperty(
        'max-width',
        '100%',
        'important'
      );

      img.style.setProperty(
        'max-height',
        '100%',
        'important'
      );

      img.style.setProperty(
        'object-fit',
        'cover',
        'important'
      );

    }

  });


  /*
    MOBILE:
    exact Console-tested layout:
    6 colors first row + 2 second row.
  */
  if (
    window.matchMedia(
      '(max-width: 767px)'
    ).matches &&
    swatches.length
  ) {

    const row =
      swatches[0].parentElement;


    if (row) {

      row.style.setProperty(
        'display',
        'grid',
        'important'
      );

      row.style.setProperty(
        'grid-template-columns',
        'repeat(6, 30px)',
        'important'
      );

      row.style.setProperty(
        'grid-auto-flow',
        'row',
        'important'
      );

      row.style.setProperty(
        'gap',
        '8px',
        'important'
      );

      row.style.setProperty(
        'width',
        '220px',
        'important'
      );

      row.style.setProperty(
        'max-width',
        '100%',
        'important'
      );

      row.style.setProperty(
        'min-width',
        '0',
        'important'
      );

      row.style.setProperty(
        'overflow',
        'visible',
        'important'
      );

      row.style.setProperty(
        'justify-content',
        'start',
        'important'
      );

      row.style.setProperty(
        'box-sizing',
        'border-box',
        'important'
      );

    }

  }


  /*
    DESKTOP:
    keep the original horizontal row.
  */
  else if (swatches.length) {

    const row =
      swatches[0].parentElement;


    if (row) {

      row.style.setProperty(
        'display',
        'flex',
        'important'
      );

      row.style.setProperty(
        'flex-wrap',
        'nowrap',
        'important'
      );

      row.style.setProperty(
        'gap',
        '10px',
        'important'
      );

      row.style.removeProperty(
        'grid-template-columns'
      );

      row.style.removeProperty(
        'grid-auto-flow'
      );

      row.style.removeProperty(
        'width'
      );

    }

  }


  /* SEARCH OPTIS SHADOW DOM */
  root.querySelectorAll('*')
    .forEach(function (element) {

      if (element.shadowRoot) {

        k2FixOptisColorSwatches(
          element.shadowRoot
        );

      }

    });

}


/* Apply when the form first loads */
k2FixOptisColorSwatches(document);


/* Reapply after OPTIS changes the selected color */
document.addEventListener(
  'click',
  function () {

    requestAnimationFrame(function () {
      k2FixOptisColorSwatches(document);
    });

    setTimeout(function () {
      k2FixOptisColorSwatches(document);
