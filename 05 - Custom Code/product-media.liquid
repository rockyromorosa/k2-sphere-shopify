<script>
/* -------------------------------------------------
   MOBILE LOGIC: FORCE DOTS + CUSTOM VIDEO + VARIANT CHANGE
   -------------------------------------------------
*/
document.addEventListener('DOMContentLoaded', () => {
  const productSection = document.querySelector('#ProductSection-{{ section.id }}');
  if (!productSection) return;

  const mainGallery = productSection.querySelector('.my-gallery');
  const masterSelect = productSection.querySelector('select[name="id"]');
  const btn = productSection.querySelector('[name="add"]');
  const btnText = productSection.querySelector('[id^="AddToCartText"]');
  
  var checkSlick = setInterval(function() {
      if (typeof $ !== 'undefined' && $(mainGallery).hasClass('slick-initialized')) {
         $(mainGallery).slick('slickSetOption', 'dots', true, true);
         $(mainGallery).slick('slickSetOption', 'arrows', false, true);
         $(mainGallery).slick('slickSetOption', 'autoplay', true, true);
         $(mainGallery).slick('slickSetOption', 'autoplaySpeed', 4000, true);
         clearInterval(checkSlick);
      }
  }, 500);

  const productHandle = "{{ product.handle }}";
  if (!productHandle) return;

  {% assign forced_video = product.metafields.custom.forced_video_file.value %}
  {% assign forced_url = forced_video.sources[0].url | default: '' %}
  const FORCED_METAFIELD_URL = "{{ forced_url }}";

  const getCleanID = (url) => {
    if (!url) return '';
    let clean = url.split('?')[0];
    const parts = clean.split('/');
    for (const part of parts) {
        if (part.length > 15 && /^[a-z0-9]+$/i.test(part)) return part;
    }
    return clean; 
  };

  fetch(`/products/${productHandle}.js`)
    .then(response => response.json())
    .then(product => {
      const mediaIdToPositionMap = new Map();
      let forcedVideoMediaId = null;
      const targetHash = getCleanID(FORCED_METAFIELD_URL);
      product.media.forEach(media => {
        mediaIdToPositionMap.set(media.id, media.position);
        if (media.media_type === 'video' || media.media_type === 'external_video') {
          const sources = media.sources || [];
          if (targetHash !== "" && sources.some(s => s.url && s.url.includes(targetHash))) {
            forcedVideoMediaId = media.id;
          }
        }
      });

      const colorOption = product.options.find(option => option.name.toLowerCase().includes('color'));
      const colorPositionMap = {};
      const colorImageRanges = {};
      
      if (colorOption) {
        product.variants.forEach(variant => {
          const colorValue = variant.options[colorOption.position - 1];
          if (variant.featured_image && !colorPositionMap[colorValue]) {
            const mediaId = variant.featured_image.id;
            if (mediaId !== forcedVideoMediaId) {
              colorPositionMap[colorValue] = variant.featured_image.position;
            }
          }
        });
        const sortedColors = Object.entries(colorPositionMap).sort((a, b) => a[1] - b[1]);
        sortedColors.forEach(([color, startPos], index) => {
          const nextColor = sortedColors[index + 1];
          const endPos = nextColor ? nextColor[1] : product.media.length + 1;
          colorImageRanges[color] = { start: startPos, end: endPos, featurePos: startPos };
        });
      }

      const getCurrentVariantFromDropdowns = () => {
        const selects = Array.from(productSection.querySelectorAll('.variant-box-select'));
        return product.variants.find(variant => {
          return selects.every(select => {
             const key = select.getAttribute('name'); 
             return variant[key] === select.value;
          });
        }) || product.variants[0];
      };

      const updateMasterSelect = (variant) => {
        if (!variant) return;
        if (masterSelect) {
          masterSelect.value = variant.id;
          masterSelect.dispatchEvent(new Event('change', { bubbles: true }));
        }
        const priceEl = productSection.querySelector('[id^="ProductPrice"]');
        const compareEl = productSection.querySelector('[id^="ComparePrice"]');
        if(priceEl) {
           priceEl.innerHTML = "USD " + (variant.price / 100).toFixed(2);
        }
        if(compareEl) {
           if(variant.compare_at_price > variant.price) {
             compareEl.innerHTML = "$" + (variant.compare_at_price / 100).toFixed(2);
             compareEl.style.display = 'inline';
           } else {
             compareEl.style.display = 'none';
           }
        }
        if (btn && btnText) {
          if (variant.available) {
             btn.disabled = false;
             btnText.textContent = window.productStrings.addToCart;
             btn.classList.remove('btn--sold-out');
             const buyNowContainer = productSection.querySelector('.product-form__buynow');
             if(buyNowContainer) buyNowContainer.style.display = 'block';
          } else {
             btn.disabled = true;
             btnText.textContent = window.productStrings.soldOut;
             btn.classList.add('btn--sold-out');
             const buyNowContainer = productSection.querySelector('.product-form__buynow');
             if(buyNowContainer) buyNowContainer.style.display = 'none';
          }
        }
      };

      const updateVariantImages = (variant) => {
        if (!variant || !colorOption) return;
        const selectedColor = variant.options[colorOption.position - 1];
        const range = colorImageRanges[selectedColor];
        if (!range) return;

        const filterSlider = (slider) => {
          if (!slider || typeof $ === 'undefined' || !$(slider).hasClass('slick-initialized')) return;
          $(slider).slick('slickUnfilter');
          let visibleSlideCount = 0;
          let featuredImageSlideIndex = 0;
          $(slider).slick('slickFilter', function(index) {
            const slide = this;
            const mediaId = parseInt(slide.dataset.imageId, 10);
            if (isNaN(mediaId)) return false;
            if (mediaId === forcedVideoMediaId) return true;
            const currentPosition = mediaIdToPositionMap.get(mediaId);
            const isVisible = currentPosition >= range.start && currentPosition < range.end;
            if (isVisible) {
              if (currentPosition === range.featurePos) featuredImageSlideIndex = visibleSlideCount;
              visibleSlideCount++;
            }
            return isVisible;
          });
          if (visibleSlideCount > 0) $(slider).slick('slickGoTo', featuredImageSlideIndex); 
          $(slider).slick('refresh');
          $(slider).slick('setPosition');
        };
        const mainGallery = productSection.querySelector('.my-gallery');
        filterSlider(mainGallery);
      };

      const onVariantChange = () => {
        const variant = getCurrentVariantFromDropdowns();
        if (variant) {
          updateMasterSelect(variant);
          setTimeout(() => updateVariantImages(variant), 50);
        }
      };

      const dropdowns = productSection.querySelectorAll('.variant-box-select');
      dropdowns.forEach(dd => dd.addEventListener('change', onVariantChange));

      setTimeout(() => {
         const initialVariant = getCurrentVariantFromDropdowns();
         updateVariantImages(initialVariant);
      }, 1000);
    });



  const wishlistBtn = productSection.querySelector('.js-wishlist-toggle');
  if(wishlistBtn) {
    const productHandle = wishlistBtn.dataset.productHandle;
    const wishlistKey = 'dtc-wishlist';
    let wishlist = JSON.parse(localStorage.getItem(wishlistKey) || '[]');
    if(wishlist.includes(productHandle)) wishlistBtn.classList.add('active');
    wishlistBtn.addEventListener('click', () => {
       wishlist = JSON.parse(localStorage.getItem(wishlistKey) || '[]');
       if(wishlist.includes(productHandle)) {
         wishlist = wishlist.filter(h => h !== productHandle);
         wishlistBtn.classList.remove('active');
       } else {
         wishlist.push(productHandle);
         wishlistBtn.classList.add('active');
       }
       localStorage.setItem(wishlistKey, JSON.stringify(wishlist));
    });
  }
});
</script>

